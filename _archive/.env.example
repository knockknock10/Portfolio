# Server-side GitHub configuration. NEVER commit the real .env file.
# The token must only ever be readable by server/serverless code
# (server/github/client.js) — never by Vite client code (no VITE_ prefix).

# Personal access token with no scopes (public read) — used for the
# contribution calendar GraphQL query. Optional: without it, the calendar
# shows a graceful "temporarily unavailable" state instead of data.
GITHUB_USERNAME=knockknock10
GITHUB_TOKEN=
